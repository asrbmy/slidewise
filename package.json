{
  "name": "slidewise",
  "version": "1.2.0",
  "private": true,
  "description": "Slidewise: a presentation editor that runs entirely in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build:e2e && SKIP_BUILD=1 node e2e/run.mjs && SKIP_BUILD=1 node e2e/perf.mjs && node e2e/sw-update.mjs",
    "audit:prod": "npm audit --omit=dev",
    "build:e2e": "BASE_PATH=/my-repo/ vite build"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "puppeteer-core": "^25.17.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
